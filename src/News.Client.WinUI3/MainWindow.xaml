<Window
    x:Class="News.Client.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:News.Client.WinUI3.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:News.Client.WinUI3.ViewModels"
    Title="News">

    <Grid x:Name="RootGrid" Loaded="RootGridLoaded">
        <Grid.Resources>
            <CollectionViewSource x:Name="GroupedNewsSource" IsSourceGrouped="True" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="16,0">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <FontIcon
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Glyph="&#xE736;" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="News" />
            </StackPanel>
        </Grid>

        <muxc:NavigationView
            x:Name="GroupsNavigationView"
            Grid.Row="1"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            MenuItemsSource="{x:Bind ViewModel.Groups}"
            PaneDisplayMode="Top"
            SelectionChanged="GroupsNavigationViewSelectionChanged">
            <muxc:NavigationView.Resources>
                <!-- Let the Mica backdrop show through instead of the default content layer. -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
            </muxc:NavigationView.Resources>

            <muxc:NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="vm:NewsGroupViewModel">
                    <TextBlock Text="{x:Bind Title}" />
                </DataTemplate>
            </muxc:NavigationView.MenuItemTemplate>

            <muxc:NavigationView.PaneFooter>
                <StackPanel
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Refresh"
                        Command="{x:Bind ViewModel.RefreshSelectedGroupCommand}"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Refresh">
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </muxc:NavigationView.PaneFooter>

            <muxc:NavigationView.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="320" />
                        <ColumnDefinition Width="3*" MinWidth="360" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <ListView
                            x:Name="NewsListView"
                            Padding="8,0,8,16"
                            ItemsSource="{Binding Source={StaticResource GroupedNewsSource}}"
                            RightTapped="NewsListViewRightTapped"
                            SelectionChanged="NewsSelectionChanged"
                            SelectionMode="Single"
                            KeyboardAcceleratorPlacementMode="Hidden">
                            <ListView.KeyboardAccelerators>
                                <KeyboardAccelerator
                                    Key="C"
                                    Invoked="CopyAsTextAcceleratorInvoked"
                                    Modifiers="Control" />
                            </ListView.KeyboardAccelerators>

                            <ListView.ContextFlyout>
                                <MenuFlyout Opening="NewsContextFlyoutOpening">
                                    <MenuFlyoutItem
                                        Command="{x:Bind ViewModel.CopySelectedAsTextCommand}"
                                        KeyboardAcceleratorTextOverride="Ctrl+C"
                                        Text="Copy as text">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator Visibility="{x:Bind ViewModel.CanOpenSelected, Mode=OneWay}" />
                                    <MenuFlyoutItem
                                        Command="{x:Bind ViewModel.CopySelectedUrlCommand}"
                                        Text="Copy URL"
                                        Visibility="{x:Bind ViewModel.CanOpenSelected, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE71B;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Command="{x:Bind ViewModel.OpenSelectedArticleCommand}"
                                        Text="Open in browser"
                                        Visibility="{x:Bind ViewModel.CanOpenSelected, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8A7;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </ListView.ContextFlyout>

                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="12,8" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="0,12,0,4"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{Binding DayLabel}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:NewsItemViewModel">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Width="64"
                                            Height="64"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Visibility="{x:Bind HasImage}">
                                            <!-- Binding (not x:Bind) so the Uri -> ImageSource conversion happens
                                                 per realized container and decoded bitmaps stay recyclable. -->
                                            <Image Source="{Binding ImageUri}" Stretch="UniformToFill" />
                                        </Border>

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                            <TextBlock
                                                MaxLines="2"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Title}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="2"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Lead}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                            <!-- Source (only in multi-source groups), views and reactions. -->
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind MetaText}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{x:Bind HasMeta}" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Top"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind TimeText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            Margin="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="No stories match your search."
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasNoMatches, Mode=OneWay}" />

                        <!-- Sits over the list so a refresh reads as the list loading. -->
                        <muxc:ProgressRing
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                        <!-- Rides over the list's top-right corner: a bare glyph until it is
                             wanted, a filter box once it is opened. -->
                        <Grid
                            Margin="0,6,12,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                            <Button
                                AutomationProperties.Name="Search"
                                Click="SearchButtonClick"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Search"
                                Visibility="{x:Bind ViewModel.IsSearchCollapsed, Mode=OneWay}">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xE721;" />
                            </Button>

                            <AutoSuggestBox
                                x:Name="SearchBox"
                                Width="240"
                                AutomationProperties.Name="Search stories"
                                KeyDown="SearchBoxKeyDown"
                                LostFocus="SearchBoxLostFocus"
                                PlaceholderText="Search title and lead"
                                QueryIcon="Find"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                                Visibility="{x:Bind ViewModel.IsSearchOpen, Mode=OneWay}" />
                        </Grid>
                    </Grid>

                    <!-- The NavigationView's own content layer is transparent so Mica shows through
                         the list; the reading pane restores it with the same built-in brushes,
                         thickness and corner radius the NavigationView content grid uses. -->
                    <Grid
                        Grid.Column="1"
                        Padding="24,8,24,16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,1,0,0"
                        CornerRadius="8,0,0,0"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource TitleTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedByline, Mode=OneWay}" />
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Command="{x:Bind ViewModel.OpenSelectedArticleCommand}"
                                IsEnabled="{x:Bind ViewModel.CanOpenSelected, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        Glyph="&#xE8A7;" />
                                    <TextBlock Text="Open" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.HasNoSelection, Mode=OneWay}">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="32"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE7C3;" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="Select a story from the list." />
                            </StackPanel>

                            <muxc:WebView2 x:Name="ArticleWebView" Visibility="{x:Bind ViewModel.IsHtmlContentMode, Mode=OneWay}" />

                            <muxc:WebView2 x:Name="BrowserWebView" Visibility="{x:Bind ViewModel.IsWebContentMode, Mode=OneWay}" />

                            <!-- Declared last so it sits above the WebView2 layers and receives the
                                 pointer wheel while the text view is showing. -->
                            <ScrollViewer
                                x:Name="TextContentScrollViewer"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                VerticalScrollMode="Enabled"
                                Visibility="{x:Bind ViewModel.IsTextContentMode, Mode=OneWay}">
                                <Grid>
                                    <TextBlock
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.SelectedPlainContent, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind ViewModel.IsPlainTextContentMode, Mode=OneWay}" />

                                    <!-- Feed bodies are usually simple HTML; this renders their structure
                                         as native flow text instead of a web view. -->
                                    <controls:HtmlTextBlock
                                        Html="{x:Bind ViewModel.SelectedHtmlContent, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsFormattedTextContentMode, Mode=OneWay}" />
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </muxc:NavigationView.Content>
        </muxc:NavigationView>
    </Grid>
</Window>
