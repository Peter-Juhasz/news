<Window
    x:Class="News.Client.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="News Reader">

    <Grid x:Name="RootGrid" Loaded="RootGridLoaded">
        <Grid.Resources>
            <CollectionViewSource x:Name="GroupedNewsSource" IsSourceGrouped="True" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <FontIcon
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="15"
                    Glyph="&#xE99A;" />
                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="News" />
            </StackPanel>
        </Grid>

        <muxc:NavigationView
            x:Name="GroupsNavigationView"
            Grid.Row="1"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Top"
            SelectionChanged="GroupsNavigationViewSelectionChanged"
            MenuItemsSource="{Binding Groups}">
            <muxc:NavigationView.MenuItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" />
                </DataTemplate>
            </muxc:NavigationView.MenuItemTemplate>

            <muxc:NavigationView.Header>
                <Grid Padding="16,8,16,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        Text="Headlines"
                        FontSize="20"
                        FontWeight="SemiBold" />

                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Padding="14,8"
                        Command="{Binding RefreshSelectedGroupCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </Grid>
            </muxc:NavigationView.Header>

            <muxc:NavigationView.Content>
                <Grid Padding="16,0,16,16" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <ListView
                            x:Name="NewsListView"
                            SelectionMode="Single"
                            ItemsSource="{Binding Source={StaticResource GroupedNewsSource}}"
                            SelectionChanged="NewsSelectionChanged">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="0,8,0,6"
                                                Text="{Binding DayLabel}"
                                                FontWeight="SemiBold"
                                                Opacity="0.85" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Width="68"
                                            Height="68"
                                            CornerRadius="6">
                                            <Image Source="{Binding ImageUri}" Stretch="UniformToFill" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock
                                                Text="{Binding Title}"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap"
                                                MaxLines="2" />
                                            <TextBlock
                                                Text="{Binding Lead}"
                                                Opacity="0.8"
                                                TextWrapping="Wrap"
                                                MaxLines="3" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Top"
                                            Text="{Binding TimeText}"
                                            Opacity="0.75" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <Border Grid.Column="1" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock
                                        Text="{Binding SelectedTitle}"
                                        FontSize="26"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedDateTimeText}" Opacity="0.8" />
                                    <HyperlinkButton
                                        Content="{Binding SelectedUrl}"
                                        NavigateUri="{Binding SelectedUrlUri}"
                                        IsEnabled="{Binding CanOpenSelected}" />
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    Padding="14,8"
                                    Command="{Binding OpenSelectedArticleCommand}"
                                    IsEnabled="{Binding CanOpenSelected}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8A7;" />
                                        <TextBlock Text="Open" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <muxc:SelectorBar
                                x:Name="ContentModeSelector"
                                Grid.Row="1"
                                SelectionChanged="ContentModeSelectorSelectionChanged">
                                <muxc:SelectorBarItem x:Name="TextModeSelectorItem" Tag="Text" Text="Text" />
                                <muxc:SelectorBarItem x:Name="HtmlModeSelectorItem" Tag="Html" Text="HTML" />
                            </muxc:SelectorBar>

                            <Grid Grid.Row="2">
                                <TextBlock
                                    x:Name="SelectStoryTextBlock"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="Select a story from the list."
                                    Opacity="0.75" />

                                <ScrollViewer x:Name="TextContentScrollViewer">
                                    <TextBlock Text="{Binding SelectedPlainContent}" TextWrapping="Wrap" />
                                </ScrollViewer>

                                <muxc:WebView2 x:Name="ArticleWebView" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </muxc:NavigationView.Content>
        </muxc:NavigationView>
    </Grid>
</Window>
