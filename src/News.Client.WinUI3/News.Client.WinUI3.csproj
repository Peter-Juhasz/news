<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <RootNamespace>News.Client.WinUI3</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <AssemblyName>news</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    
    <!-- Unpackaged (no MSIX): the app carries its own copy of the Windows App SDK runtime,
         so it runs on a machine where that runtime was never installed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <!-- CsWinRT writes the WinRT interfaces of the generic collections handed to WinUI — the day
         groups, the group list — in unsafe code, and without leave to do so it quietly writes none:
         a natively compiled app then has nothing to hand over, and the list turns them away. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- The experimental Windows App SDK generates XamlTypeInfo code that uses its own
         evaluation-only controls (charts, tabular), which warns CS8305 in code this project
         does not write. -->
    <NoWarn>$(NoWarn);CS8305</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PeterJuhasz.Text.Html" Version="1.*-*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.*" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="11.*" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.*-experimental*" />
    <PackageReference Include="System.Reactive" Version="7.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\News.Domain\News.Domain.csproj" />
    <ProjectReference Include="..\News.Services\News.Services.csproj" />
    <ProjectReference Include="..\News.Services.Atom\News.Services.Atom.csproj" />
    <ProjectReference Include="..\News.Services.GitHub\News.Services.GitHub.csproj" />
    <ProjectReference Include="..\News.Services.Html\News.Services.Html.csproj" />
    <ProjectReference Include="..\News.Services.Rss\News.Services.Rss.csproj" />
    <ProjectReference Include="..\News.Services.X\News.Services.X.csproj" />
  </ItemGroup>

    <!-- Every compiled XAML page is indexed into Acc.pri rather than written beside the exe, and the
       WinUI targets copy that file to the build output without ever offering it to the publish
       pipeline — the hand-off they do have runs only for an MSIX package, which this app is not.
       A published app therefore has no XAML to find and dies inside InitializeComponent, before a
       window exists to say so: no dialog, nothing in the event log, exit code 0xC000027B. -->
  <Target Name="PublishProjectPriFile" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" Condition="Exists('$(ProjectPriFullPath)')">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="groups.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include=".env" Condition="Exists('.env')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
